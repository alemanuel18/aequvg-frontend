# Nombre aislado para los recursos creados por Docker Compose.
COMPOSE_PROJECT_NAME=aequvg-frontend

# Puerto publicado del servidor Nuxt de desarrollo.
FRONTEND_PORT=3001

# URL utilizada por el navegador.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# URL utilizada por Nuxt durante renderizado en el servidor desde Docker.
NUXT_API_BASE_URL=http://host.docker.internal:3000/api/v1

# Versión oficial del aviso de privacidad aceptado en formularios públicos.
NUXT_PUBLIC_PRIVACY_VERSION=pendiente-validacion
